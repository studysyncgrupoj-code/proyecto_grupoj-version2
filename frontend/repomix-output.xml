            </Link>
          );
        })}
      </nav>

      {/* Navigation Menu - Mobile */}
      {mobileMenuOpen && (
        <div className="border-border bg-background absolute top-20 right-4 left-4 z-50 flex flex-col items-stretch gap-1 rounded-2xl border p-4 shadow-2xl lg:hidden">
          {HEADER_LINKS.map((link) => {

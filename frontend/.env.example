# ==========================================
# Runtime
# ==========================================

# URL base del backend Spring Boot.
API_BASE_URL=http://localhost:8080

# Modo del cliente de backend: 'rest' para Spring Boot o 'mock' sin backend.
BACKEND_MODE=rest

# Secreto utilizado por Auth.js / NextAuth.
# Cada desarrollador debe generar su propio valor.
# Generar con: openssl rand -base64 32
AUTH_SECRET=

# ==========================================
# Tests (integración real + E2E)
# ==========================================
# Estas variables solo las usan los scripts en /scripts y las suites
# E2E. En producción/desarrollo normal no son necesarias.

# Credenciales de un usuario de pruebas existente en el backend.
# Se usan para POST /auth/login en scripts/backend-integration-tests.ts.
TEST_EMAIL=usuario@example.com
TEST_PASSWORD=tu-password-de-prueba

# UUID de un usuario existente en el backend, para probar
# GET /users/:userId/profile (perfil público).
# Si se omite, ese test se marca como SKIP.
TEST_USER_ID=00000000-0000-0000-0000-000000000000

# Ejecutar las mutaciones que alteran la cuenta de pruebas
# (change-password, 2FA, deactivate, subscription, billing...).
#   - Sin definir o con cualquier valor distinto de '0' → ON
#   - Con '0' → OFF (solo se ejecutan lecturas)
# Usa RUN_DESTRUCTIVE_TESTS=0 si tu cuenta de pruebas no es desechable.
RUN_DESTRUCTIVE_TESTS=1
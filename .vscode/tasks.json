{
  "version": "2.0.0",
  "tasks": [
    {
      "type": "shell",
      "label": "1. Iniciar Backend (Spring Boot)",
      "command": "mvn spring-boot:run",
      "options": {
        "cwd": "${workspaceFolder}/backend/studysync-api"
      },
      "problemMatcher": [],
      "presentation": {
        "panel": "new",
        "reveal": "always"
      }
    },
    {
      "type": "shell",
      "label": "2. Iniciar Frontend (pnpm dev)",
      "command": "pnpm dev",
      "options": {
        "cwd": "${workspaceFolder}/frontend"
      },
      "problemMatcher": [],
      "presentation": {
        "panel": "new",
        "reveal": "always"
      }
    },
    {
      "label": "🚀 Arrancar Todo (Backend y Frontend)",
      "dependsOn": [
        "1. Iniciar Backend (Spring Boot)",
        "2. Iniciar Frontend (pnpm dev)"
      ],
      "runOptions": {
        "runOn": "folderOpen"
      },
      "problemMatcher": [],
      "isBackground": true
    }
  ]
}

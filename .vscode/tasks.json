{
  "version": "2.0.0",
  "tasks": [
    {
      "type": "shell",
      "label": "1. Iniciar Backend (Spring Boot)",
      "command": "mvn spring-boot:run",
      "options": {
        "cwd": "${workspaceFolder}/backend/studysync-api"
      },
      "isBackground": true,
      "problemMatcher": {
        "owner": "java",
        "pattern": {
          "regexp": "^.*$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "Starting StudySyncApplication",
          "endsPattern": "Started StudySyncApplication"
        }
      },
      "presentation": {
        "panel": "new",
        "reveal": "always"
      }
    },
    {
      "type": "shell",
      "label": "2. Iniciar Frontend (pnpm dev)",
      "command": "pnpm dev",
      "options": {
        "cwd": "${workspaceFolder}/frontend"
      },
      "isBackground": true,
      "problemMatcher": {
        "owner": "typescript",
        "pattern": {
          "regexp": "^.*$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "started server",
          "endsPattern": "Ready in"
        }
      },
      "presentation": {
        "panel": "new",
        "reveal": "always"
      }
    },
    {
      "label": "🚀 Arrancar Todo (Backend y Frontend)",
      "dependsOn": [
        "1. Iniciar Backend (Spring Boot)",
        "2. Iniciar Frontend (pnpm dev)"
      ],
      "dependsOrder": "parallel",
      "runOptions": {
        "runOn": "folderOpen"
      },
      "problemMatcher": [],
      "isBackground": true
    }
  ]
}
